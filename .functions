# shellcheck shell=bash

# Use Git’s colored diff when available
if command -v git >/dev/null 2>&1; then
	diff() {
		git diff --no-index --color-words "$@"
	}
fi

# Escape text into its UTF-8 byte representation.
escape() {
	printf '%s' "$@" | LC_ALL=C od -An -tx1 | awk '{
		for (i = 1; i <= NF; i++) printf "\\x%s", toupper($i)
	}' || return
	# print a newline unless we’re piping the output to another program
	if [ -t 1 ]; then
		printf '\n'
	fi
	return 0
}

# Show all the names (CNs and SANs) listed in the SSL certificate
# for a given domain
getcertnames() {
	if [ -z "${1:-}" ]; then
		echo "ERROR: No domain specified."
		return 1
	fi

	local domain="${1}"
	echo "Testing ${domain}…"
	echo # newline

	local tmp
	tmp=$(openssl s_client -connect "${domain}:443" -servername "$domain" </dev/null 2>&1) || {
		echo "ERROR: Certificate not found."
		return 1
	}

	if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
			local certText
			certText=$(printf '%s\n' "${tmp}" \
				| openssl x509 -text -certopt "no_header, no_serial, no_version, \
				no_signame, no_validity, no_issuer, no_pubkey, no_sigdump, no_aux")
				echo "Common Name:"
				echo # newline
				printf '%s\n' "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//"
				echo # newline
				echo "Subject Alternative Name(s):"
				echo # newline
				printf '%s\n' "${certText}" | grep -A 1 "Subject Alternative Name:" \
					| sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2
				return 0
	else
			echo "ERROR: Certificate not found."
			return 1
	fi
}

# Shorten the logical working directory while retaining its physical target.
short() {
	local target link
	if [ -n "${DOTFILES_SHORT_DIR:-}" ]; then
		long || return
	fi
	target=$(pwd -P) || return
	DOTFILES_SHORT_DIR=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-short.XXXXXX") || return
	link="$DOTFILES_SHORT_DIR/S"
	if ! ln -s "$target" "$link"; then
		rmdir "$DOTFILES_SHORT_DIR"
		unset DOTFILES_SHORT_DIR
		return 1
	fi
	if ! cd "$link"; then
		rm -f "$link"
		rmdir "$DOTFILES_SHORT_DIR"
		unset DOTFILES_SHORT_DIR
		return 1
	fi
}

# Restore the physical working directory and remove short()'s temporary link.
long() {
	local target short_dir
	target=$(pwd -P) || return
	short_dir=${DOTFILES_SHORT_DIR:-}
	cd "$target" || return
	case "$short_dir" in
		"${TMPDIR:-/tmp}"/dotfiles-short.*)
			[ ! -L "$short_dir/S" ] || rm -f "$short_dir/S"
			rmdir "$short_dir" 2>/dev/null || true
			;;
	esac
	unset DOTFILES_SHORT_DIR
}

cmt() {
  claude --dangerously-skip-permissions "commit"
}

killport() {
	local port=${1:-}
	local pids pid result=0
	case "$port" in
		'' | *[!0-9]*)
			printf 'Usage: killport <1-65535>\n' >&2
			return 1
			;;
	esac
	if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
		printf 'Usage: killport <1-65535>\n' >&2
		return 1
	fi
	if ! command -v lsof >/dev/null 2>&1; then
		printf 'killport: lsof is required\n' >&2
		return 1
	fi
	pids=$(lsof -nP -t -iTCP:"$port" -sTCP:LISTEN) || true
	if [ -z "$pids" ]; then
		printf 'No process is listening on port %s\n' "$port"
		return 0
	fi
	while IFS= read -r pid; do
		case "$pid" in
			'' | *[!0-9]*) continue ;;
		esac
		printf 'Stopping PID %s on port %s\n' "$pid" "$port"
		kill "$pid" || result=1
	done <<< "$pids"
	return "$result"
}
